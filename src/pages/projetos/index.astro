---
import Layout from '../../layouts/Layout.astro';import Card from '../../components/ProjectCard.astro';import {projects} from '../../data/projects';
---
<Layout title="Projetos — Forma"><section class="wrap page-heading"><span class="eyebrow">Portfólio / 2023 — 2025</span><h1>Diferentes espaços.<br/>A mesma <em>essência.</em></h1><p>Uma seleção de estudos fictícios sobre o encontro entre pessoas, materiais e paisagens.</p></section><section class="wrap section catalog"><div class="filter-bar" role="group" aria-label="Filtrar projetos">{['Todos','Residencial','Interiores','Comercial','Salvos'].map((c,i)=><button data-filter={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}<span id="result-count" role="status">6 projetos</span></div><div class="project-grid">{projects.map((p,i)=><Card project={p} index={i}/>)}</div><div id="empty" class="empty" hidden><h2>Seu olhar, suas referências.</h2><p>Toque no + de um projeto para salvá-lo neste dispositivo.</p><button class="button" id="reset-filter">Explorar todos os projetos ↗</button></div></section><script>
let selected='Todos';const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');const update=()=>{let saved:string[]=[];try{saved=JSON.parse(localStorage.getItem('forma-saved')||'[]')}catch{}let count=0;document.querySelectorAll<HTMLElement>('.project').forEach(card=>{const show=selected==='Todos'||(selected==='Salvos'?saved.includes(card.dataset.slug!):card.dataset.category===selected);card.hidden=!show;if(show)count++});document.querySelector('#result-count')!.textContent=`${count} ${count===1?'projeto':'projetos'}`;(document.querySelector('#empty') as HTMLElement).hidden=count>0;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===selected)))};buttons.forEach(b=>b.addEventListener('click',()=>{selected=b.dataset.filter!;update()}));document.querySelector('#reset-filter')?.addEventListener('click',()=>{selected='Todos';update()});document.addEventListener('savedchange',update);
</script></Layout>
