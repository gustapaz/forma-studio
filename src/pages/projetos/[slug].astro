---
import Layout from '../../layouts/Layout.astro';import Picture from '../../components/Picture.astro';import {projects,base} from '../../data/projects';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,index}}))};const {project:p,index}=Astro.props;const next=projects[(index+1)%projects.length];
---
<Layout title={`${p.name} — Forma`} description={p.description}><section class="wrap page-heading detail-heading"><a class="eyebrow" href={`${base}projetos/`}>← Todos os projetos</a><h1>{p.name}</h1><div class="detail-meta"><span>{p.category}</span><span>{p.place}</span><span>{p.area} m²</span><span>{p.year}</span></div></section><div class="detail-image"><Picture name={p.image} alt={p.alt} hero/></div><section class="wrap section statement"><span class="eyebrow">O conceito</span><div><h2>{p.concept}</h2><p>{p.description}</p><p>Este é um estudo conceitual demonstrativo. As imagens são referências visuais licenciadas e não representam uma obra executada pelo estúdio.</p><h3 class="materials-title">Paleta de materiais</h3><ul class="materials">{p.materials.map(m=><li>{m}</li>)}</ul><a class="text-link" href={`${base}contato/`}>Imaginar um espaço assim <span>↗</span></a></div></section><section class="next-project"><div class="wrap"><span class="eyebrow">Próximo projeto</span><a href={`${base}projetos/${next.slug}/`}>{next.name}<span>↗</span></a></div></section></Layout>
